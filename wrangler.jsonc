{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Worker entry + static assets are generated by `opennextjs-cloudflare build` — don't change these.
	"main": ".open-next/worker.js",
	"name": "owen",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding; the service name must match the worker name.
			// See https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "owen"
		}
	],
	// Serve the app on the custom domain (the dinmukhammed.com zone must be on this Cloudflare account).
	"routes": [{ "pattern": "owen.dinmukhammed.com", "custom_domain": true }],
	"observability": {
		"enabled": true
	}
	// No R2 incremental cache: the app has no ISR/revalidation (see open-next.config.ts).
	// No IMAGES binding: the app doesn't use next/image.
	// Server-side secrets are set with `npx wrangler secret put <NAME>` (never committed here).
}
